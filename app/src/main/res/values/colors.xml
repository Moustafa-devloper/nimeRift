package com.animrift.app.utils;

import com.animrift.app.network.SourceValidator;

public final class UrlUtils {

    private UrlUtils() {
    }

    public static boolean isLikelyPlayableUrl(String url) {
        if (url == null || url.trim().isEmpty()) {
            return false;
        }

        return SourceValidator.isValidHttpUrl(url)
                || url.startsWith("content://")
                || url.startsWith("file://");
    }
}
